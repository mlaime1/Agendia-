generator client {
  provider = "prisma-client-js"
  engine   = "binary"
}

datasource db {
  provider = "postgresql"
}

/// Semantic name for the transported person. Physical table is still `clients` (see @@map), so no migration is required.
/// Scalar FK columns keep their physical/wire name `client_id`; only relation fields use `passenger`.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model passenger {
  id                 BigInt      @id(map: "cliente_pkey") @default(autoincrement())
  created_at         DateTime    @default(now()) @db.Timestamptz(6)
  nombre             String      @db.VarChar
  phone              Decimal     @db.Decimal
  billing_cycle      BillingCycle
  billing_day        Int?
  billing_start_date DateTime?   @db.Date
  timezone           String      @default("America/Argentina/Buenos_Aires") @db.VarChar
  auth_id            String?     @unique(map: "clients_auth_id_key")
  driver_id          BigInt?
  rates              rates[]
  routes             routes[]
  summaries          summaries[]
  trips              trips[]
  driver             users?      @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  invitation_codes   invitation_codes[]
  client_access      passenger_client_access[]
  service_schedules  service_schedules[]

  @@map("clients")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model rates {
  id              BigInt         @id @default(autoincrement())
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  client_id       BigInt?
  route_id        BigInt?
  base_price      Decimal        @db.Decimal
  surcharge_price Decimal?       @db.Decimal
  start_date      DateTime?      @db.Date
  end_date        DateTime?      @db.Date
  trip_type       trip_type_enum @default(ida)
  passenger       passenger?     @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routes          routes?        @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trips           trips[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model route_stops {
  id         BigInt   @id @default(autoincrement())
  created_at DateTime @default(now()) @db.Timestamptz(6)
  address    String?  @db.VarChar
  stop_order Decimal? @db.Decimal
  lat        Decimal? @db.Decimal(10, 7)
  lng        Decimal? @db.Decimal(10, 7)
  route_id   BigInt?
  routes     routes?  @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routes {
  id         BigInt        @id @default(autoincrement())
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  name       String?       @db.VarChar
  client_id  BigInt?
  is_active  Boolean       @default(true)
  deleted_at DateTime?     @db.Timestamptz(6)
  rates       rates[]
  route_stops route_stops[]
  passenger   passenger?   @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trips       trips[]

  @@index([is_active])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model summaries {
  id           BigInt    @id @default(autoincrement())
  created_at   DateTime? @default(now()) @db.Timestamptz(6)
  client_id    BigInt
  driver_id    BigInt
  period_start DateTime  @db.Date
  period_end   DateTime  @db.Date
  period_type  PeriodType
  total_trips  Int       @default(0)
  total_amount Decimal   @default(0) @db.Decimal
  paid_amount  Decimal   @default(0) @db.Decimal
  status       String    @default("draft") @db.VarChar
  sent_at      DateTime? @db.Timestamptz(6)
  paid_at      DateTime? @db.Timestamptz(6)
  archived_at  DateTime? @db.Timestamptz(6)
  whatsapp_msg String?
  notes        String?   @db.VarChar
  passenger    passenger @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users        users     @relation(fields: [driver_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trips        trips[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model trips {
  id               BigInt         @id @default(autoincrement())
  created_at       DateTime       @default(now()) @db.Timestamptz(6)
  user_id          BigInt
  client_id        BigInt
  route_id         BigInt?
  rate_id          BigInt?
  trip_date        DateTime       @db.Timestamptz(6)
  trip_type        trip_type_enum
  final_price      Decimal        @db.Decimal
  has_surcharge    Boolean        @default(false)
  surcharge_reason String?        @db.VarChar
  special_type     String?        @db.VarChar
  notes            String?        @db.VarChar
  summary_id       BigInt?
  started_at       DateTime?      @db.Timestamptz(6)
  ended_at         DateTime?      @db.Timestamptz(6)
  start_lat        Decimal?       @db.Decimal(10, 7)
  start_lng        Decimal?       @db.Decimal(10, 7)
  end_lat          Decimal?       @db.Decimal(10, 7)
  end_lng          Decimal?       @db.Decimal(10, 7)
  payment_status   payment_status_enum @default(pending)
  paid_amount      Decimal        @default(0) @db.Decimal
  passenger        passenger      @relation(fields: [client_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  rates            rates?         @relation(fields: [rate_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routes           routes?        @relation(fields: [route_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  summaries        summaries?     @relation(fields: [summary_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  trip_stops       trip_stops[]
  payments         payments[]
  users            users          @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model trip_stops {
  id         BigInt    @id @default(autoincrement())
  trip_id    BigInt
  lat        Decimal   @db.Decimal(10, 7)
  lng        Decimal   @db.Decimal(10, 7)
  stopped_at DateTime  @default(now()) @db.Timestamptz(6)
  trips      trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

model payments {
  id          BigInt    @id @default(autoincrement())
  trip_id     BigInt
  amount      Decimal   @db.Decimal
  method      String    @db.VarChar
  paid_at     DateTime  @default(now()) @db.Timestamptz(6)
  notes       String?   @db.VarChar
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  trips       trips     @relation(fields: [trip_id], references: [id], onDelete: Cascade)

  @@index([trip_id])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id         BigInt      @id(map: "user_pkey") @default(autoincrement())
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  name       String      @db.VarChar
  email      String      @db.VarChar
  alias      String?     @db.VarChar
  auth_id    String?     @unique
  role       Role        @default(DRIVER)
  summaries  summaries[]
  trips      trips[]
  passengers passenger[]
  client_access      passenger_client_access[]
  invitations_created invitation_codes[] @relation("InvitationCreator")
  invitations_used   invitation_codes[] @relation("InvitationUsedBy")
}

enum trip_type_enum {
  ida
  ida_y_vuelta @map("ida y vuelta")
  especial
}

enum payment_status_enum {
  pending
  partial
  paid
}

/// Physical enum still stores the value PASSENGER (see @map). No migration required.
enum Role {
  DRIVER
  ADMIN
  CLIENT @map("PASSENGER")
}

enum BillingCycle {
  weekly
  biweekly
  monthly
}

enum PeriodType {
  weekly
  biweekly
  monthly
  manual
}

model invitation_codes {
  id          BigInt    @id @default(autoincrement())
  code        String    @unique
  driver_id   BigInt
  client_id   BigInt?
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  expires_at  DateTime  @db.Timestamptz(6)
  used_at     DateTime? @db.Timestamptz(6)
  used_by_id  BigInt?

  driver      users     @relation("InvitationCreator", fields: [driver_id], references: [id])
  passenger   passenger? @relation(fields: [client_id], references: [id])
  used_by     users?    @relation("InvitationUsedBy", fields: [used_by_id], references: [id])

  @@index([code])
  @@index([driver_id])
}

/// Bridge between an authenticated account (users) and the passenger it can manage.
/// Physical columns are `client_id` (-> passenger) and `user_id` (-> users); see @map.
/// `client_user_id` is used instead of `client_id` because Prisma forbids a field name colliding with the mapped column of another field.
model passenger_client_access {
  passenger_id   BigInt   @map("client_id")
  client_user_id BigInt   @map("user_id")
  added_at       DateTime @default(now()) @db.Timestamptz(6)

  passenger passenger @relation(fields: [passenger_id], references: [id], onDelete: Cascade, map: "client_passengers_client_id_fkey")
  client    users     @relation(fields: [client_user_id], references: [id], onDelete: Cascade, map: "client_passengers_user_id_fkey")

  @@id([passenger_id, client_user_id], map: "client_passengers_pkey")
  @@index([client_user_id], map: "client_passengers_user_id_idx")
  @@map("client_passengers")
}

model service_schedules {
  id          BigInt    @id @default(autoincrement())
  client_id   BigInt
  day_of_week Int
  pickup_time DateTime  @db.Time(0)
  return_time DateTime? @db.Time(0)
  label       String?   @db.VarChar(100)
  is_active   Boolean   @default(true)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  updated_at  DateTime  @updatedAt @db.Timestamptz(6)

  passenger   passenger @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@unique([client_id, day_of_week, pickup_time])
  @@index([client_id])
}
