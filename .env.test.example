# Test environment — copy this file to .env.test and adjust values.
NODE_ENV=test
PORT=3001

# Dedicated test database. The name MUST contain "_test" or "test".
# This example assumes you are using the local Supabase Postgres instance on port 54322.
DATABASE_URL="postgresql://postgres:postgres@localhost:54322/agendia_test?schema=public"

# Supabase local instance (required for auth integration tests).
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SERVICE_ROLE_KEY="your-local-service-role-key"
SUPABASE_ANON_KEY="your-local-anon-key"

# Optional: set to true to see Prisma queries while debugging tests.
# DEBUG_TESTS=false
